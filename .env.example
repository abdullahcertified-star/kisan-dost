# Kisan Dost Environment Variables

# Application
APP_NAME="Kisan Dost - AI Agricultural Assistant"
APP_VERSION=0.1.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL Database (Neon / Cloud PostgreSQL)
# Example: postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host/neondb?sslmode=require

# Authentication Secrets
JWT_SECRET=generate_strong_random_secret_with_openssl_rand_base64_32

# Frontend Config
NEXT_PUBLIC_API_URL=http://localhost:8000
