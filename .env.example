# Kisan Dost Environment Variables

# Application
APP_NAME="Kisan Dost - AI Agricultural Assistant"
APP_VERSION=0.1.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Google Gemini / ADK Configuration
